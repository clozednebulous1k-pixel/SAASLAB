rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Cole o MESMO UID de js/owner-config.js (Authentication → Users → User UID)
    function ownerUid() {
      return 'MIeIJUA1ASPyBugizErLH98OIvR2';
    }

    function isPrimaryOwner() {
      return request.auth != null && request.auth.uid == ownerUid();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'admin';
    }

    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function authEmailLower() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email != ''
        ? request.auth.token.email.lower()
        : '';
    }

    function validUserCreate() {
      return request.resource.data.keys().hasOnly(
          ['email', 'role', 'libraryAccess', 'authProvider', 'createdAt', 'updatedAt']
        )
        && request.resource.data.role == 'user'
        && request.resource.data.libraryAccess == false
        && request.resource.data.email == authEmailLower()
        && request.resource.data.libraryAccess is bool;
    }

    function validLabFieldTypes() {
      let d = request.resource.data;
      return (!('labSaasName' in d) || (d.labSaasName is string && d.labSaasName.size() <= 120))
        && (!('labSaasBrief' in d) || (d.labSaasBrief is string && d.labSaasBrief.size() <= 2000))
        && (!('labOnboarded' in d) || d.labOnboarded is bool)
        && (!('labCurrentStep' in d) || d.labCurrentStep is int)
        && (!('labCompletedSteps' in d) || d.labCompletedSteps is list)
        && (!('labSelectedDb' in d) || d.labSelectedDb is string)
        && (!('labSelectedAuth' in d) || d.labSelectedAuth is string)
        && (!('labSelectedDeploy' in d) || d.labSelectedDeploy is string)
        && (!('labSelectedPayment' in d) || d.labSelectedPayment is string)
        && (!('labCourseDone' in d) || d.labCourseDone is bool);
    }

    // Usuário comum: progresso do lab só no próprio doc; nunca altera role nem libraryAccess
    function validUserSelfPatch() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.libraryAccess == resource.data.libraryAccess
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email', 'authProvider', 'updatedAt',
            'labSaasName', 'labSaasBrief', 'labOnboarded', 'labCurrentStep', 'labCompletedSteps',
            'labSelectedDb', 'labSelectedAuth', 'labSelectedDeploy', 'labSelectedPayment', 'labCourseDone'
          ])
        && validLabFieldTypes();
    }

    function validEmailAccessWrite() {
      return request.resource.data.keys().hasOnly(['active', 'email', 'updatedAt'])
        && request.resource.data.active is bool
        && request.resource.data.email == email;
    }

    // Dono pode mudar libraryAccess, role NUNCA muda pelo app (só Console Firebase)
    function validOwnerUserPatch() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.libraryAccess is bool
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['libraryAccess', 'updatedAt']);
    }

    match /email_access/{email} {
      // get por ID (e-mail): verificar compra antes do 1º login. list só dono.
      allow get: if true;
      allow list: if isPrimaryOwner();
      allow create, update, delete: if isPrimaryOwner() && validEmailAccessWrite();
    }

    match /users/{userId} {
      allow get: if isSelf(userId) || isPrimaryOwner();
      allow list: if isPrimaryOwner();

      allow create: if isSelf(userId) && validUserCreate();

      allow update: if isSelf(userId) && validUserSelfPatch();

      allow update: if isPrimaryOwner()
        && !isSelf(userId)
        && validOwnerUserPatch();

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
